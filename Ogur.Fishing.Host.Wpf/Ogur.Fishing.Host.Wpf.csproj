<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ApplicationIcon>Assets\ogur.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

<ItemGroup>
  <PackageReference Include="Ogur.Abstractions" Version="0.1.5-alpha" />
  <PackageReference Include="Ogur.Core"         Version="0.1.4-alpha" />
  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
  <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
  <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
  <PackageReference Include="NLog" Version="5.2.8" />
</ItemGroup>

<ItemGroup>
  <ProjectReference Include="..\Ogur.Capabilities.Fishing\Ogur.Capabilities.Fishing.csproj" />
  <ProjectReference Include="..\Ogur.Infrastructure\Ogur.Infrastructure.csproj" />
</ItemGroup>


  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\Servers\" />
    <Folder Include="Composition\" />
    <Folder Include="Views\Controls\" />
  </ItemGroup>

   <ItemGroup>
    <Resource Include="Assets\Servers\*.png" />
    <None Remove="Assets\ogur.ico" />
    <Resource Include="Assets\ogur.ico" />
  </ItemGroup>

   <ItemGroup>
     <Page Update="Views\MainWindow.xaml">
       <Generator>MSBuild:Compile</Generator>
       <XamlRuntime>Wpf</XamlRuntime>
       <SubType>Designer</SubType>
     </Page>
   </ItemGroup>

</Project>