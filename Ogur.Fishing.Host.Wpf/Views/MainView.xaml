<UserControl x:Class="Ogur.Fishing.Host.Wpf.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:beh="clr-namespace:Ogur.Fishing.Host.Wpf.Behaviors"
             xmlns:vm="clr-namespace:Ogur.Fishing.Host.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Grid Margin="20"
          Grid.IsSharedSizeScope="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto" SharedSizeGroup="MainRow"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Fishing Capability"
                   Style="{StaticResource TitleText}"
                   VerticalAlignment="Center" />

        <!-- Pin toggle + opis -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Margin="12,0,0,0">

            <ToggleButton Style="{StaticResource IconToggleButton}"
                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window},
                                          Path=Topmost,
                                          Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>

            <TextBlock Text="Always on top"
                       Foreground="{StaticResource Brush.TextMuted}"
                       FontSize="13"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Controls -->
        <Border Grid.Row="2"
                Grid.Column="0"
                Style="{StaticResource Card}"
                Margin="0,0,16,0"
                VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bait slots -->
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Bait slot:"/>
                <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource Brush.BgElevated}" CornerRadius="8" Padding="6">
                  <ListBox
                      ItemsSource="{Binding BaitItems}"
                      SelectedItem="{Binding SelectedBait}"
                      BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled"
                      Background="Transparent"
                      SelectionMode="Single">
                      
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="8" Rows="1"/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                      
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="3"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>

                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="Cell"
                                      Width="44" Height="32"
                                      CornerRadius="8"
                                      Background="#11FFFFFF"
                                      BorderBrush="{StaticResource Brush.Border}"
                                      BorderThickness="1"
                                      SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                  <Setter TargetName="Cell" Property="Background" Value="#203152"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Cell" Property="Opacity" Value="0.6"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
                
                <!-- Process -->
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Process:"
                           Style="{StaticResource LabelText}"/>

                <ComboBox Grid.Row="2" Grid.Column="2"
                          Style="{StaticResource ComboBox.ShortSelected_FullDropdown}"
                          ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          MinWidth="320"
                          VerticalAlignment="Center"/>

                <Button Grid.Row="2"
                        Grid.Column="3"
                        Command="{Binding RefreshProcessesCommand}"
                        Content="Refresh"
                        Style="{StaticResource PrimaryButton}"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"/>

                <!-- Memory address -->
                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Memory addr:" Style="{StaticResource LabelText}"/>
                <TextBox Grid.Row="6" Grid.Column="2"
                         Text="{Binding MemoryAddress, UpdateSourceTrigger=PropertyChanged}" MinWidth="320" VerticalAlignment="Center"/>

                <!-- Start/Stop/Test -->
                <StackPanel Grid.Row="8" Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Command="{Binding TestCommand}" Content="Test" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="0,0,8,0"/>
                    <Button Command="{Binding StartCommand}" Content="Start" Style="{StaticResource PrimaryButton}" MinWidth="96" Margin="0,0,8,0"/>
                    <Button Command="{Binding StopCommand}" Content="Stop" Style="{StaticResource PrimaryButton}" MinWidth="96"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Timers placeholder -->
        <Border Grid.Row="2"
                Grid.Column="1"
                Style="{StaticResource Card}"
                Margin="0"
                VerticalAlignment="Stretch">
            <TextBlock Text="Timers view will be placed here..."
                       Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Status + Events -->
        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                Padding="12" BorderThickness="1" BorderBrush="#404040"
                CornerRadius="8" Background="{StaticResource Brush.BgElevated}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <Border Grid.Row="1" Background="#0E1420" CornerRadius="8" Padding="6" Height="260">
                    <ListBox ItemsSource="{Binding Events}"
                             Style="{StaticResource ListBox.Dark}"
                             beh:AutoScroll.IsEnabled="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Margin="4,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
