<UserControl x:Class="Ogur.Fishing.Host.Wpf.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Ogur.Fishing.Host.Wpf.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2"
                   Text="Fishing Capability"
                   FontSize="20"
                   FontWeight="SemiBold"/>

        <!-- Controls -->
        <Border Grid.Row="2" Grid.Column="0" Padding="12" BorderThickness="1" BorderBrush="#404040" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Bait slots (1..4, F1..F4) -->
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Bait slot:"/>
                <ListBox Grid.Row="0" Grid.Column="2"
                         ItemsSource="{Binding BaitItems}"
                         SelectedItem="{Binding SelectedBait}"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="8" CornerRadius="6" BorderThickness="1" BorderBrush="#505050">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Process -->
                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Process:"/>
                <ComboBox Grid.Row="2" Grid.Column="2"
                          ItemsSource="{Binding Processes}"
                          SelectedItem="{Binding SelectedProcess}"
                          DisplayMemberPath="Display"
                          MinWidth="220"/>
                <Button Grid.Row="2" Grid.Column="3"
                        Command="{Binding RefreshProcessesCommand}"
                        Content="Refresh" Padding="12,6"/>

                <!-- Hotkey -->
                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Hotkey:"/>
                <TextBox Grid.Row="4" Grid.Column="2"
                         Text="{Binding HotkeyText}" IsReadOnly="True" MinWidth="220"/>
                <Button Grid.Row="4" Grid.Column="3"
                        Command="{Binding ListenHotkeyCommand}"
                        Content="Listen" Padding="12,6"/>

                <!-- Memory address -->
                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="Memory addr:"/>
                <TextBox Grid.Row="6" Grid.Column="2"
                         Text="{Binding MemoryAddress, UpdateSourceTrigger=PropertyChanged}" MinWidth="220"/>

                <!-- Start/Stop/Test -->
                <StackPanel Grid.Row="8" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Command="{Binding TestCommand}" Content="Test" Padding="16,8"/>
                    <Button Command="{Binding StartCommand}" Content="Start" Padding="16,8"/>
                    <Button Command="{Binding StopCommand}" Content="Stop" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status + Events -->
        <Border Grid.Row="2" Grid.Column="1" Padding="12" BorderThickness="1" BorderBrush="#404040" CornerRadius="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Events}"/>
            </DockPanel>
        </Border>

        <!-- Timers placeholder -->
        <Border Grid.Row="4" Grid.ColumnSpan="2" Padding="12" BorderThickness="1" BorderBrush="#303030" CornerRadius="8">
            <TextBlock Text="Timers view will be placed here..." Opacity="0.7"/>
        </Border>
    </Grid>
</UserControl>