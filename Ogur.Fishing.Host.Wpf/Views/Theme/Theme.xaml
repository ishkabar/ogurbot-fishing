<!-- File: Ogur.Fishing.Host.Wpf/Views/Theme/Theme.xaml -->
<!-- Project: Ogur.Fishing.Host.Wpf -->
<!-- Namespace: Ogur.Fishing.Host.Wpf.Views.Theme -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== Palette ===== -->
  <Color x:Key="Color.Bg">#12151C</Color>
  <Color x:Key="Color.BgElevated">#1A1F2A</Color>
  <Color x:Key="Color.Text">#F2F2F2</Color>
  <Color x:Key="Color.TextMuted">#CCFFFFFF</Color>
  <Color x:Key="Color.Primary">#2E88FF</Color>
  <Color x:Key="Color.PrimaryHover">#3C96FF</Color>
  <Color x:Key="Color.Border">#2E88FF</Color>
  <Color x:Key="Color.Error">#EF5350</Color>

  <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}"/>
  <SolidColorBrush x:Key="Brush.BgElevated" Color="{StaticResource Color.BgElevated}"/>
  <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}"/>
  <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}"/>
  <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
  <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}"/>
  <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
  <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}"/>

  <!-- ===== Common text ===== -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Margin" Value="0,0,0,12"/>
  </Style>

  <Style x:Key="LabelText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Margin" Value="0,8,0,4"/>
  </Style>

  <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}"/>
  </Style>

  <!-- ===== Inputs ===== -->
  <Style TargetType="TextBox">
    <Setter Property="MinWidth" Value="320"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="#11FFFFFF"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="MinWidth" Value="320"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="#11FFFFFF"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
  </Style>

  <!-- ===== Buttons ===== -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Height" Value="38"/>
    <Setter Property="MinWidth" Value="120"/>
    <Setter Property="Padding" Value="16,6"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="Background" Value="{StaticResource Brush.Primary}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="{StaticResource Brush.PrimaryHover}"/>
              <Setter Property="BorderBrush" Value="{StaticResource Brush.PrimaryHover}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="Background" Value="#253041"/>
    <Setter Property="BorderBrush" Value="#2A2F38"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#2D3A50"/>
              <Setter Property="BorderBrush" Value="#3A465A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Cards ===== -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.BgElevated}"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="28"/>
    <Setter Property="Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Window base ===== -->
  <Style x:Key="BaseWindowStyle" TargetType="Window">
    <Setter Property="Background" Value="{StaticResource Brush.Bg}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="UseLayoutRounding" Value="True"/>
    <Setter Property="Width" Value="1160"/>
    <Setter Property="Height" Value="720"/>
    <Setter Property="ResizeMode" Value="CanMinimize"/>
    <Setter Property="WindowStyle" Value="SingleBorderWindow"/>
  </Style>

  <!-- ===== Dark ListBox (console/log) ===== -->
  <Style x:Key="ListBox.Dark" TargetType="ListBox">
    <Setter Property="Background" Value="#0E1420"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Item"/>
  </Style>

  <!-- ===== Server select ===== -->
  <Style x:Key="ServerCardButton" TargetType="Button">
    <Setter Property="Width" Value="220"/>
    <Setter Property="Height" Value="220"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{StaticResource Brush.BgElevated}"
                  BorderBrush="#2A2F38"
                  BorderThickness="1"
                  CornerRadius="14"
                  SnapsToDevicePixels="True"
                  ClipToBounds="True">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="52"/>
              </Grid.RowDefinitions>

              <Border Grid.Row="0" Background="#151A22" CornerRadius="14,14,0,0">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="12"/>
              </Border>

              <Border Grid.Row="1" Background="#ECEFF4" CornerRadius="0,0,14,14">
                <TextBlock Text="{TemplateBinding Tag}"
                           Foreground="#1E1E1E"
                           FontWeight="SemiBold"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
              </Border>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
              <Setter TargetName="Root" Property="Effect">
                <Setter.Value>
                  <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="#202635"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===================================================== -->
  <!-- COMBOBOX (DARK BASE) + FULL/LIST & SHORT/SELECT STYLE -->
  <!-- ===================================================== -->
  
  <Style x:Key="ComboBox.Dark" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="MinWidth" Value="320"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="#11FFFFFF"/>
    <Setter Property="Foreground" Value="{StaticResource Brush.Text}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <TextBlock Text="{Binding Display}" Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>


<Style x:Key="ComboBox.ShortSelected_FullDropdown"
       TargetType="ComboBox"
       BasedOn="{StaticResource ComboBox.Dark}">
  <Setter Property="Template">
    <Setter.Value>
      <ControlTemplate TargetType="ComboBox">
        <Grid SnapsToDevicePixels="True">

          <ToggleButton x:Name="PART_ToggleButton"
                        Focusable="False"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
            <ToggleButton.Template>
              <ControlTemplate TargetType="ToggleButton">
                <Border x:Name="Face"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                  <Grid>
  
                    <TextBlock Margin="0,0,22,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                               Text="{Binding SelectedItem.DisplayShort, RelativeSource={RelativeSource AncestorType=ComboBox}, FallbackValue=Select process...}"/>

                    <Path HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 8 0 L 4 4 Z"
                          Fill="{StaticResource Brush.TextMuted}"
                          Margin="0,0,6,0"/>
                  </Grid>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Brush.Primary}"/>
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Face" Property="Opacity" Value="0.55"/>
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>
          
          <Popup x:Name="PART_Popup"
                 Placement="Bottom"
                 AllowsTransparency="True"
                 Focusable="False"
                 IsOpen="{TemplateBinding IsDropDownOpen}"
                 PopupAnimation="Fade">
            <Border Background="{StaticResource Brush.BgElevated}"
                    BorderBrush="#2A2F38"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="2"
                    Margin="0,2,0,0">
              <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>

        <ControlTemplate.Triggers>
          <Trigger Property="HasItems" Value="False">
            <Setter TargetName="PART_Popup" Property="MinHeight" Value="0"/>
          </Trigger>
          <Trigger Property="IsEditable" Value="True">

          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value>
  </Setter>
</Style>
  
  <Style x:Key="IconToggleButton" TargetType="ToggleButton">
    <Setter Property="Width" Value="42"/>
    <Setter Property="Height" Value="42"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="ToolTip" Value="Keep window always on top"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border CornerRadius="8" Background="Transparent">
            <Grid>

              <Path x:Name="Icon"
                    Data="M7,2 L9,4 L7,6 L13,12 L11,14 L5,8 L3,10 L1,8 L3,6 L1,4 L3,2 L5,4 Z"
                    Stretch="Uniform"
                    Width="20" Height="20"
                    Fill="{StaticResource Brush.TextMuted}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Brush.Text}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Brush.Primary}"/>
              <Setter Property="ToolTip" Value="Unpin window"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Icon" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
