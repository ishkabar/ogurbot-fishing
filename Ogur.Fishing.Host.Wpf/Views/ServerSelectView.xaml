<UserControl x:Class="Bot.Host.Wpf.Views.ServerSelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
            <TextBlock Text="Select Server & Device" FontSize="22" FontWeight="Bold" Margin="0,0,0,12"/>
            <ComboBox ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" Height="34"/>
            <Button Content="Proceed" Height="38" Margin="0,12,0,0" Command="{Binding ProceedCommand}"/>
            <TextBlock Text="HWID and licensing will be validated here in future." Opacity="0.6" Margin="0,12,0,0" />
        </StackPanel>
    </Grid>
</UserControl>