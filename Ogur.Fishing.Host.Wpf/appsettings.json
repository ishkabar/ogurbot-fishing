{
  "Hub": {
    "HubUrl": "https://api.hub.ogur.dev",
    "EnableSignalR": true,
    "ReconnectDelaySeconds": 5,
    "RequestTimeoutSeconds": 30
  },

  "License": {
    "RequireValidLicense": true,
    "CheckIntervalMinutes": 60,
    "GracePeriodMinutes": 1440
  },

  "Updates": {
    "CheckOnStartup": true,
    "CheckIntervalHours": 6,
    "AutoDownload": false,
    "AutoInstall": false
  },

  "ChatDetection": {
    "ScanStart": "0x0CC00000",
    "ScanEnd": "0x0D600000",
    "SnapshotCount": 100,
    "IntervalMs": 50,
    "ReadChunkSize": 4096,
    "MinChangeCount": 10,
    "RegionGroupingGap": 1024
  },
  
  "Ui": {
    "Default": {
      "WindowWidth": 1200,
      "WindowHeight": 800,
      "FontSizeBase": 14,
      "FontSizeTitle": 24,
      "ControlHeight": 38,
      "CornerRadius": 8,
      "Spacing": 12
    },
    "Login": {
      "WindowWidth": 840,
      "WindowHeight": 560,
      "FontSizeBase": 15,
      "FontSizeTitle": 28,
      "ControlHeight": 42,
      "CornerRadius": 10,
      "Spacing": 14
    }
  },

  "Fishing": {
    "PollIntervalMs": 250,
    "BiteTimeoutSeconds": 9,
    "DebugOverlay": false,
    "PostBaitDelayMs": 200,
    "SpaceBetweenPressMs": 0,
    "CooldownMs": 1850,
    "ChatWaitTimeoutMs": 5000,
    "Legacy": {
      "ChatMessageAddress": 202392362,
      "SpaceCountOffset": 20,
      "ChatReadLength": 100,
      "CountReadLength": 3,
      "KnownKeys": [
        "|cff27c112"
      ],
      "KnownCountPhrases": [
        "nij 1 spacji aby wy",
        "nij 2 spacji aby wy",
        "nij 3 spacji aby wy"
      ]
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Ogur": "Debug",
      "Ogur.Core": "Debug",
      "Ogur.Fishing": "Information"
    }
  }
}